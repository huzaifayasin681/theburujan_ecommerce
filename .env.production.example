# ==============================================================================
# The Burujan Ecommerce - Production Environment Template
# Domain: theburujan.shop
# ==============================================================================

NODE_ENV=production
API_PORT=4000
WEB_PORT=3000

# --- Host Loopback Ports (Avoids collisions with other apps on your VPS) ---
HOST_API_PORT=4005
HOST_WEB_PORT=3005

# --- Domain & URL Configuration ---
APP_URL=https://theburujan.shop
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://api:4000/api/v1
CORS_ORIGINS=https://theburujan.shop,https://www.theburujan.shop
COOKIE_DOMAIN=.theburujan.shop
STORE_CURRENCY=USD

# --- MySQL Database Configuration ---
# Generate secure passwords using: openssl rand -base64 24
MYSQL_DATABASE=burujan
MYSQL_USER=burujan
MYSQL_PASSWORD=replace_with_strong_db_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
DATABASE_URL=mysql://burujan:replace_with_strong_db_password@mysql:3306/burujan

# --- Redis Cache & Queue Configuration ---
REDIS_URL=redis://redis:6379

# --- Authentication & JWT Security ---
# Generate using: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_32_or_64_character_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_32_or_64_character_random_hex_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- MinIO / S3 Object Storage ---
# For MinIO inside Docker Compose:
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=burujan
S3_ACCESS_KEY=burujan_minio_admin
S3_SECRET_KEY=replace_with_strong_minio_secret_key
S3_FORCE_PATH_STYLE=true

# --- Email / SMTP Settings (Hostinger Email or Brevo/SendGrid/Gmail) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@theburujan.shop
SMTP_PASSWORD=your_hostinger_email_password
SMTP_FROM=The Burujan <contact@theburujan.shop>

# --- Payment Gateways (Optional / Live or Test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL=https://api-m.paypal.com

# --- Initial Super Admin Seed Credentials ---
SEED_SUPER_ADMIN_EMAIL=admin@theburujan.shop
SEED_SUPER_ADMIN_PASSWORD=replace_with_admin_password_min_12_chars

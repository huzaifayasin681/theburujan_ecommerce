generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING_DELETION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  COD
}

enum InventoryReason {
  PURCHASE
  ORDER
  RETURN
  REFUND
  CANCELLATION
  MANUAL_ADJUSTMENT
  DAMAGE
  RESTOCK
  RESERVATION
  RELEASE
}

enum CouponType {
  PERCENTAGE
  FIXED_CART
  FIXED_PRODUCT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUND_PENDING
  COMPLETED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                    String                  @id @default(uuid()) @db.Char(36)
  email                 String                  @unique @db.VarChar(320)
  passwordHash          String                  @db.VarChar(255)
  firstName             String                  @db.VarChar(100)
  lastName              String                  @db.VarChar(100)
  phone                 String?                 @db.VarChar(32)
  avatarUrl             String?                 @db.VarChar(2048)
  status                UserStatus              @default(ACTIVE)
  emailVerifiedAt       DateTime?
  twoFactorSecret       String?                 @db.VarChar(255)
  twoFactorEnabled      Boolean                 @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  sessions              UserSession[]
  roles                 UserRole[]
  addresses             Address[]
  carts                 Cart[]
  wishlist              Wishlist?
  orders                Order[]
  couponUsages          CouponUsage[]
  couponRestrictions    CouponCustomer[]
  reviews               Review[]
  reviewVotes           ReviewVote[]
  returns               ReturnRequest[]
  notifications         Notification[]
  auditLogs             AuditLog[]              @relation("AuditActor")
  inventoryTransactions InventoryTransaction[]  @relation("InventoryActor")
  recoveryCodes         TwoFactorRecoveryCode[]
  consents              UserConsent[]

  @@index([status])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  codeHash  String    @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model UserConsent {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  type       String   @db.VarChar(80)
  version    String   @db.VarChar(40)
  accepted   Boolean
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type, version])
  @@index([type, createdAt])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  refreshTokenHash String    @db.VarChar(255)
  familyId         String    @db.Char(36)
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  type      String    @db.VarChar(32)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @unique @db.VarChar(64)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Char(36)
  roleId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Address {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            String   @db.Char(36)
  name              String   @db.VarChar(120)
  phone             String   @db.VarChar(32)
  country           String   @db.Char(2)
  state             String   @db.VarChar(100)
  city              String   @db.VarChar(100)
  postalCode        String   @db.VarChar(24)
  line1             String   @db.VarChar(255)
  line2             String?  @db.VarChar(255)
  instructions      String?  @db.VarChar(500)
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Brand {
  id             String    @id @default(uuid()) @db.Char(36)
  name           String    @db.VarChar(120)
  slug           String    @unique @db.VarChar(160)
  logoUrl        String?   @db.VarChar(2048)
  description    String?   @db.Text
  website        String?   @db.VarChar(2048)
  seoTitle       String?   @db.VarChar(70)
  seoDescription String?   @db.VarChar(170)
  active         Boolean   @default(true)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, name])
}

model Category {
  id               String            @id @default(uuid()) @db.Char(36)
  name             String            @db.VarChar(120)
  slug             String            @unique @db.VarChar(160)
  parentId         String?           @db.Char(36)
  imageUrl         String?           @db.VarChar(2048)
  description      String?           @db.Text
  active           Boolean           @default(true)
  seoTitle         String?           @db.VarChar(70)
  seoDescription   String?           @db.VarChar(170)
  sortOrder        Int               @default(0)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]        @relation("CategoryTree")
  products         ProductCategory[]
  couponCategories CouponCategory[]

  @@index([parentId, active, sortOrder])
}

model Product {
  id               String             @id @default(uuid()) @db.Char(36)
  name             String             @db.VarChar(255)
  slug             String             @unique @db.VarChar(255)
  sku              String             @unique @db.VarChar(100)
  description      String             @db.Text
  shortDescription String?            @db.VarChar(500)
  richDescription  String?            @db.LongText
  basePrice        Decimal            @db.Decimal(19, 4)
  salePrice        Decimal?           @db.Decimal(19, 4)
  costPrice        Decimal?           @db.Decimal(19, 4)
  currency         String             @default("USD") @db.Char(3)
  taxClassId       String?            @db.Char(36)
  brandId          String?            @db.Char(36)
  status           ProductStatus      @default(DRAFT)
  visibility       Visibility         @default(PUBLIC)
  weightGrams      Int?
  lengthMm         Int?
  widthMm          Int?
  heightMm         Int?
  seoTitle         String?            @db.VarChar(70)
  seoDescription   String?            @db.VarChar(170)
  averageRating    Decimal            @default(0) @db.Decimal(3, 2)
  reviewCount      Int                @default(0)
  soldCount        Int                @default(0)
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  brand            Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxClass         TaxClass?          @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  categories       ProductCategory[]
  tags             ProductTag[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  couponProducts   CouponProduct[]

  @@index([status, visibility, createdAt])
  @@index([brandId, status])
  @@index([name])
  @@index([soldCount])
}

model ProductImage {
  id        String           @id @default(uuid()) @db.Char(36)
  productId String           @db.Char(36)
  mediaId   String?          @db.Char(36)
  url       String           @db.VarChar(2048)
  altText   String?          @db.VarChar(255)
  sortOrder Int              @default(0)
  featured  Boolean          @default(false)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]

  @@index([productId, sortOrder])
  @@index([mediaId])
}

model ProductVariant {
  id             String                  @id @default(uuid()) @db.Char(36)
  productId      String                  @db.Char(36)
  sku            String                  @unique @db.VarChar(100)
  price          Decimal?                @db.Decimal(19, 4)
  salePrice      Decimal?                @db.Decimal(19, 4)
  imageId        String?                 @db.Char(36)
  weightGrams    Int?
  active         Boolean                 @default(true)
  combinationKey String                  @db.VarChar(500)
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  image          ProductImage?           @relation(fields: [imageId], references: [id], onDelete: SetNull)
  values         VariantAttributeValue[]
  inventory      Inventory?
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  couponVariants CouponVariant[]

  @@unique([productId, combinationKey])
  @@index([productId, active])
}

model ProductAttribute {
  id        String                  @id @default(uuid()) @db.Char(36)
  productId String                  @db.Char(36)
  name      String                  @db.VarChar(100)
  sortOrder Int                     @default(0)
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@unique([productId, name])
}

model ProductAttributeValue {
  id          String                  @id @default(uuid()) @db.Char(36)
  attributeId String                  @db.Char(36)
  value       String                  @db.VarChar(120)
  sortOrder   Int                     @default(0)
  attribute   ProductAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    VariantAttributeValue[]

  @@unique([attributeId, value])
}

model VariantAttributeValue {
  variantId String                @db.Char(36)
  valueId   String                @db.Char(36)
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value     ProductAttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, valueId])
  @@index([valueId])
}

model ProductCategory {
  productId  String   @db.Char(36)
  categoryId String   @db.Char(36)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Tag {
  id       String       @id @default(uuid()) @db.Char(36)
  name     String       @unique @db.VarChar(80)
  products ProductTag[]
}

model ProductTag {
  productId String  @db.Char(36)
  tagId     String  @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Inventory {
  id                String                 @id @default(uuid()) @db.Char(36)
  variantId         String                 @unique @db.Char(36)
  available         Int                    @default(0)
  reserved          Int                    @default(0)
  sold              Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  version           Int                    @default(0)
  updatedAt         DateTime               @updatedAt
  variant           ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  transactions      InventoryTransaction[]
  reservations      InventoryReservation[]

  @@index([available])
}

model InventoryTransaction {
  id             String          @id @default(uuid()) @db.Char(36)
  inventoryId    String          @db.Char(36)
  reason         InventoryReason
  availableDelta Int
  reservedDelta  Int             @default(0)
  soldDelta      Int             @default(0)
  referenceType  String?         @db.VarChar(50)
  referenceId    String?         @db.VarChar(64)
  note           String?         @db.VarChar(500)
  actorId        String?         @db.Char(36)
  createdAt      DateTime        @default(now())
  inventory      Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  actor          User?           @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
}

model InventoryReservation {
  id          String    @id @default(uuid()) @db.Char(36)
  inventoryId String    @db.Char(36)
  cartId      String?   @db.Char(36)
  orderId     String?   @db.Char(36)
  quantity    Int
  expiresAt   DateTime
  releasedAt  DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([expiresAt, releasedAt, convertedAt])
  @@index([cartId])
  @@index([orderId])
}

model Cart {
  id             String     @id @default(uuid()) @db.Char(36)
  userId         String?    @unique @db.Char(36)
  guestTokenHash String?    @unique @db.Char(64)
  couponCode     String?    @db.VarChar(64)
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([userId, updatedAt])
  @@index([expiresAt])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Char(36)
  cartId    String         @db.Char(36)
  productId String         @db.Char(36)
  variantId String         @db.Char(36)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Char(36)
  userId    String         @unique @db.Char(36)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String          @id @default(uuid()) @db.Char(36)
  wishlistId String          @db.Char(36)
  productId  String          @db.Char(36)
  variantId  String?         @db.Char(36)
  createdAt  DateTime        @default(now())
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
}

model Order {
  id              String               @id @default(uuid()) @db.Char(36)
  orderNumber     String               @unique @db.VarChar(32)
  userId          String?              @db.Char(36)
  email           String               @db.VarChar(320)
  status          OrderStatus          @default(PENDING)
  currency        String               @db.Char(3)
  subtotal        Decimal              @db.Decimal(19, 4)
  discountTotal   Decimal              @db.Decimal(19, 4)
  taxTotal        Decimal              @db.Decimal(19, 4)
  shippingTotal   Decimal              @db.Decimal(19, 4)
  grandTotal      Decimal              @db.Decimal(19, 4)
  shippingAddress Json
  billingAddress  Json
  customerNote    String?              @db.VarChar(1000)
  idempotencyKey  String               @unique @db.VarChar(128)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  refunds         Refund[]
  shipments       Shipment[]
  couponUsages    CouponUsage[]
  returns         ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id              String       @id @default(uuid()) @db.Char(36)
  orderId         String       @db.Char(36)
  productId       String?      @db.Char(36)
  variantId       String?      @db.Char(36)
  productName     String       @db.VarChar(255)
  sku             String       @db.VarChar(100)
  variantSnapshot Json?
  unitPrice       Decimal      @db.Decimal(19, 4)
  taxTotal        Decimal      @db.Decimal(19, 4)
  discountTotal   Decimal      @db.Decimal(19, 4)
  quantity        Int
  lineTotal       Decimal      @db.Decimal(19, 4)
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnItems     ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Char(36)
  orderId     String       @db.Char(36)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?      @db.Char(36)
  notes       String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model Payment {
  id             String          @id @default(uuid()) @db.Char(36)
  orderId        String          @db.Char(36)
  provider       PaymentProvider
  transactionId  String?         @unique @db.VarChar(255)
  idempotencyKey String          @unique @db.VarChar(128)
  amount         Decimal         @db.Decimal(19, 4)
  currency       String          @db.Char(3)
  status         PaymentStatus   @default(PENDING)
  failureReason  String?         @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events         PaymentEvent[]
  refunds        Refund[]

  @@index([orderId, status])
}

model PaymentEvent {
  id              String          @id @default(uuid()) @db.Char(36)
  paymentId       String?         @db.Char(36)
  provider        PaymentProvider
  providerEventId String          @db.VarChar(255)
  type            String          @db.VarChar(120)
  payloadHash     String          @db.Char(64)
  processedAt     DateTime?
  error           String?         @db.VarChar(1000)
  receivedAt      DateTime        @default(now())
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
}

model Refund {
  id               String       @id @default(uuid()) @db.Char(36)
  orderId          String       @db.Char(36)
  paymentId        String       @db.Char(36)
  idempotencyKey   String       @unique @db.VarChar(128)
  providerRefundId String?      @unique @db.VarChar(255)
  amount           Decimal      @db.Decimal(19, 4)
  currency         String       @db.Char(3)
  reason           String       @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model ShippingZone {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @db.VarChar(120)
  countries   Json
  states      Json?
  postalCodes Json?
  active      Boolean          @default(true)
  methods     ShippingMethod[]
}

model ShippingMethod {
  id        String       @id @default(uuid()) @db.Char(36)
  zoneId    String       @db.Char(36)
  name      String       @db.VarChar(120)
  type      String       @db.VarChar(32)
  basePrice Decimal      @db.Decimal(19, 4)
  freeAbove Decimal?     @db.Decimal(19, 4)
  rules     Json?
  active    Boolean      @default(true)
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([zoneId, active])
}

model Shipment {
  id             String    @id @default(uuid()) @db.Char(36)
  orderId        String    @db.Char(36)
  carrier        String?   @db.VarChar(100)
  trackingNumber String?   @db.VarChar(255)
  trackingUrl    String?   @db.VarChar(2048)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([trackingNumber])
}

model TaxClass {
  id       String    @id @default(uuid()) @db.Char(36)
  name     String    @unique @db.VarChar(100)
  rates    TaxRate[]
  products Product[]
}

model TaxRate {
  id            String   @id @default(uuid()) @db.Char(36)
  taxClassId    String   @db.Char(36)
  country       String   @db.Char(2)
  state         String?  @db.VarChar(100)
  postalPattern String?  @db.VarChar(50)
  rate          Decimal  @db.Decimal(7, 4)
  inclusive     Boolean  @default(false)
  priority      Int      @default(0)
  active        Boolean  @default(true)
  taxClass      TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)

  @@index([taxClassId, country, state, active])
}

model Coupon {
  id              String           @id @default(uuid()) @db.Char(36)
  code            String           @unique @db.VarChar(64)
  type            CouponType
  value           Decimal          @db.Decimal(19, 4)
  minimumSpend    Decimal?         @db.Decimal(19, 4)
  maximumDiscount Decimal?         @db.Decimal(19, 4)
  startsAt        DateTime?
  expiresAt       DateTime?
  usageLimit      Int?
  perUserLimit    Int?
  usedCount       Int              @default(0)
  firstOrderOnly  Boolean          @default(false)
  minimumQuantity Int?
  stackable       Boolean          @default(false)
  active          Boolean          @default(true)
  usages          CouponUsage[]
  products        CouponProduct[]
  variants        CouponVariant[]
  categories      CouponCategory[]
  customers       CouponCustomer[]

  @@index([active, startsAt, expiresAt])
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Char(36)
  couponId       String   @db.Char(36)
  userId         String?  @db.Char(36)
  orderId        String   @db.Char(36)
  discountAmount Decimal  @db.Decimal(19, 4)
  usedAt         DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
}

model CouponProduct {
  couponId  String  @db.Char(36)
  productId String  @db.Char(36)
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponVariant {
  couponId  String         @db.Char(36)
  variantId String         @db.Char(36)
  coupon    Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([couponId, variantId])
}

model CouponCategory {
  couponId   String   @db.Char(36)
  categoryId String   @db.Char(36)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponCustomer {
  couponId String @db.Char(36)
  userId   String @db.Char(36)
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([couponId, userId])
  @@index([userId])
}

model Review {
  id               String       @id @default(uuid()) @db.Char(36)
  productId        String       @db.Char(36)
  userId           String       @db.Char(36)
  orderItemId      String?      @db.Char(36)
  rating           Int
  title            String       @db.VarChar(150)
  body             String       @db.Text
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  helpfulCount     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes            ReviewVote[]
  media            ReviewMedia[]

  @@unique([productId, userId, orderItemId])
  @@index([productId, status, createdAt])
}

model ReviewVote {
  reviewId String  @db.Char(36)
  userId   String  @db.Char(36)
  helpful  Boolean
  review   Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model ReviewMedia {
  reviewId String @db.Char(36)
  mediaId  String @db.Char(36)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([reviewId, mediaId])
  @@index([mediaId])
}

model ReturnRequest {
  id          String       @id @default(uuid()) @db.Char(36)
  orderId     String       @db.Char(36)
  userId      String       @db.Char(36)
  status      ReturnStatus @default(REQUESTED)
  reason      String       @db.VarChar(100)
  explanation String?      @db.Text
  adminNote   String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       ReturnItem[]
  media       ReturnMedia[]

  @@index([orderId, status])
  @@index([userId, createdAt])
}

model ReturnItem {
  id          String        @id @default(uuid()) @db.Char(36)
  returnId    String        @db.Char(36)
  orderItemId String        @db.Char(36)
  quantity    Int
  restock     Boolean       @default(false)
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
}

model ReturnMedia {
  returnId String        @db.Char(36)
  mediaId  String        @db.Char(36)
  request  ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  media    Media         @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([returnId, mediaId])
  @@index([mediaId])
}

model Notification {
  id        String              @id @default(uuid()) @db.Char(36)
  userId    String?             @db.Char(36)
  channel   NotificationChannel
  type      String              @db.VarChar(100)
  subject   String              @db.VarChar(255)
  body      String              @db.Text
  data      Json?
  readAt    DateTime?
  sentAt    DateTime?
  failedAt  DateTime?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([sentAt, failedAt])
}

model Media {
  id           String          @id @default(uuid()) @db.Char(36)
  key          String          @unique @db.VarChar(512)
  url          String          @db.VarChar(2048)
  mimeType     String          @db.VarChar(120)
  sizeBytes    Int
  originalName String          @db.VarChar(255)
  altText      String?         @db.VarChar(255)
  visibility   MediaVisibility @default(PUBLIC)
  uploadedById String?         @db.Char(36)
  createdAt    DateTime        @default(now())
  reviewLinks  ReviewMedia[]
  returnLinks  ReturnMedia[]
  productImages ProductImage[]

  @@index([uploadedById, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Char(36)
  actorId      String?  @db.Char(36)
  action       String   @db.VarChar(120)
  resourceType String   @db.VarChar(100)
  resourceId   String?  @db.VarChar(64)
  metadata     Json?
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(512)
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

model Setting {
  key         String   @id @db.VarChar(120)
  value       Json
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Char(36)
  updatedAt   DateTime @updatedAt

  @@index([isPublic])
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Char(36)
  key            String    @unique @db.VarChar(128)
  scope          String    @db.VarChar(64)
  userId         String?   @db.Char(36)
  requestHash    String    @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  lockedUntil    DateTime
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([scope, userId, createdAt])
  @@index([lockedUntil])
}

model NewsletterSubscription {
  id             String    @id @default(uuid()) @db.Char(36)
  email          String    @unique @db.VarChar(320)
  verifiedAt     DateTime?
  unsubscribedAt DateTime?
  consentedAt    DateTime
  consentIp      String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  verificationTokens NewsletterVerificationToken[]
}

model NewsletterVerificationToken {
  id             String   @id @default(uuid()) @db.Char(36)
  subscriptionId String   @db.Char(36)
  tokenHash      String   @unique @db.Char(64)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())
  subscription   NewsletterSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@index([subscriptionId, usedAt, expiresAt])
}

model ContactMessage {
  id         String    @id @default(uuid()) @db.Char(36)
  name       String    @db.VarChar(120)
  email      String    @db.VarChar(320)
  phone      String?   @db.VarChar(32)
  subject    String    @db.VarChar(200)
  message    String    @db.Text
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt, resolvedAt])
}

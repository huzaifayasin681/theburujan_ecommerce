{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS", "declaration": true, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "sourceMap": true, "outDir": "dist",
    "baseUrl": ".", "incremental": true, "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts"]
}
